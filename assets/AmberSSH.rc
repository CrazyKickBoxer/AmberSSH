// AmberSSH.rc — application icon and version block.
//
// IDI_APPICON is deliberately the first icon in the file: the Windows shell
// picks the lowest-numbered icon resource as the executable's display icon.
#include "resource.h"
#include <windows.h>

IDI_APPICON ICON "AmberSSH.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Amber SSH"
            VALUE "FileDescription",  "Amber SSH \x2014 GPU Particle Terminal"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AmberSSH"
            VALUE "LegalCopyright",   "Copyright \xA9 2026 Amber SSH. All rights reserved."
            VALUE "OriginalFilename", "AmberSSH.exe"
            VALUE "ProductName",      "Amber SSH"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
